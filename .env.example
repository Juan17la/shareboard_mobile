# Copy to `.env` and adjust. All keys are read at build time.
# `EXPO_PUBLIC_` vars are inlined into the JS bundle by Expo.
#
# Leave these unset for local development: the app falls back to the values in
# `app.json` -> `expo.extra` and automatically swaps `localhost` for the LAN
# host Expo is serving from, so a phone or emulator reaches the dev machine.
# Set them explicitly only to point at a different backend.

# REST base URL for the Node backend (no trailing slash).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# WebSocket endpoint for realtime board sync.
# EXPO_PUBLIC_WS_URL=ws://192.168.1.20:3000/ws

# When "true", the app runs fully offline against in-memory mocks
# (src/services/api/mocks.ts + src/services/realtime/mock-realtime.ts).
# Defaults to "false" — the app talks to the real backend.
EXPO_PUBLIC_USE_MOCKS=false
