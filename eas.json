{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "beta": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://shareboard-server.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://shareboard-server.onrender.com/ws",
        "EXPO_PUBLIC_RELEASE": "1.2.0-beta"
      }
    },
    "perf": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://shareboard-server.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://shareboard-server.onrender.com/ws",
        "EXPO_PUBLIC_RELEASE": "1.1.0-beta",
        "EXPO_PUBLIC_PERF_HUD": "1"
      }
    },
    "perf-nomirror": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://shareboard-server.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://shareboard-server.onrender.com/ws",
        "EXPO_PUBLIC_RELEASE": "1.1.0-beta",
        "EXPO_PUBLIC_PERF_HUD": "1",
        "EXPO_PUBLIC_NO_MIRROR": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
